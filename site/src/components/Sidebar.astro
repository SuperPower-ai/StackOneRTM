---
import { buildNav } from "../lib/catalog";

type Props = {
  currentSlug?: string;
};

const { currentSlug = "" } = Astro.props;
const nav = buildNav();
const base = import.meta.env.BASE_URL;
const withBase = (slug: string) => `${base}${slug}/`;
const currentMonth = Number(currentSlug.match(/^month-(\d+)/)?.[1] || 0);
---

<aside class="sidebar" id="sidebar">
  <h2>Your path</h2>
  <p class="sidebar-note">One page a day. Stay until the gate is true.</p>
  {nav.map((month) => (
    <details class:list={["nav-month", month.status !== "published" && "is-soon"]} open={month.number === currentMonth || (!currentMonth && month.number === 1)}>
      <summary>
        <span class="nav-num">{String(month.number).padStart(2, "0")}</span>
        {month.status === "published" ? (
          <a
            class="month-link"
            href={withBase(month.slug)}
            aria-current={currentSlug === month.slug ? "page" : undefined}
          >
            {month.title}
          </a>
        ) : (
          <span class="forthcoming">{month.title}</span>
        )}
      </summary>
      {month.weeks.length > 0 && (
        <div class="nav-week">
          {month.weeks.map((week) => (
            <div>
              <p>Week {week.week}</p>
              {week.days.map((day) => (
                <a
                  href={withBase(day.slug)}
                  aria-current={currentSlug === day.slug ? "page" : undefined}
                  title={day.title}
                >
                  D{day.day} · {day.title}
                </a>
              ))}
            </div>
          ))}
        </div>
      )}
    </details>
  ))}
</aside>
