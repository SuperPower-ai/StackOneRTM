---
import type { DocRecord } from "../lib/catalog";

type Props = {
  prev?: DocRecord;
  next?: DocRecord;
};

const { prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (slug: string) => `${base}${slug}/`;
---

<nav class="pager" aria-label="Adjacent chapters">
  {prev ? (
    <a href={href(prev.slug)}>
      <span>Previous</span>
      {prev.kicker ? `${prev.kicker}` : prev.title}
    </a>
  ) : <span></span>}
  {next && (
    <a class="next" href={href(next.slug)}>
      <span>Next</span>
      {next.kicker ? `${next.kicker}` : next.title}
    </a>
  )}
</nav>
