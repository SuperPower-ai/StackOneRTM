---
import type { DocRecord } from "../lib/catalog";

type Props = {
  prev?: DocRecord;
  next?: DocRecord;
};

const { prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (slug: string) => `${base}${slug}/`;
---

<nav class="pager" aria-label="Adjacent chapters">
  {prev ? (
    <a href={href(prev.slug)}>
      <span>Previous chapter</span>
      {prev.title}
    </a>
  ) : <span class="pager-spacer"></span>}
  {next && (
    <a class="next" href={href(next.slug)}>
      <span>Open next</span>
      {next.title}
    </a>
  )}
</nav>
