---
import { searchIndex } from "../lib/catalog";

type Props = {
  current?: "home" | "read" | "projects" | "roadmap";
};

const { current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
const catalog = searchIndex();
const start = `${base}month-01/week-01/day-01/`;
---

<header class="site-header">
  <button class="icon-btn menu-btn" type="button" data-nav-toggle aria-expanded="false" aria-controls="sidebar" aria-label="Open chapter list">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  </button>
  <a class="brand" href={base}>
    <span class="brand-mark">Mastery</span>
    <span class="brand-sub">Daily textbook</span>
  </a>
  <nav class="header-nav" aria-label="Site">
    <a href={base} aria-current={current === "home" ? "page" : undefined}>Home</a>
    <a href={`${base}month-01/`} aria-current={current === "read" ? "page" : undefined}>Read</a>
    <a href={`${base}projects/`} aria-current={current === "projects" ? "page" : undefined}>Projects</a>
    <a href={`${base}roadmap/`} aria-current={current === "roadmap" ? "page" : undefined}>Roadmap</a>
    <a class="continue-link" data-continue-link href={start}>Continue</a>
    <button class="search-open" type="button" data-search-open>
      Search <span><kbd>/</kbd></span>
    </button>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle color theme">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6 6l1.5 1.5M16.5 16.5 18 18M18 6l-1.5 1.5M7.5 16.5 6 18M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>

<dialog class="dialog" data-search-dialog aria-label="Search the textbook">
  <form class="search-box" method="dialog" onsubmit="return false">
    <p class="search-hint">Jump to a month, day, or project. Press <kbd>Esc</kbd> to close.</p>
    <input type="search" data-search-input placeholder="Try “postgres”, “Month 12”, or a day title" autocomplete="off" />
    <ul class="search-hits" data-search-hits></ul>
  </form>
</dialog>

<script id="search-catalog" type="application/json" set:html={JSON.stringify(catalog).replace(/</g, "\\u003c")} />
