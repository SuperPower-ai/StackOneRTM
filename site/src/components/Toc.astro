---
import type { TocItem } from "../lib/markdown";

type Props = {
  items: TocItem[];
};

const { items } = Astro.props;
const filtered = items.filter((item) => !/^(how to use this textbook|optional review links)$/i.test(item.text));
---

<nav class="toc" aria-label="On this page">
  <h2>On this page</h2>
  {filtered.length === 0 ? (
    <p style="color: var(--muted); font-size: 0.88rem; margin: 0;">This chapter is short enough to read straight through.</p>
  ) : (
    <ol>
      {filtered.map((item) => (
        <li>
          <a class={`depth-${item.depth}`} href={`#${item.id}`}>{item.text}</a>
        </li>
      ))}
    </ol>
  )}
</nav>
