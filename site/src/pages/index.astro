---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { MONTHS } from "../data/months";
import { firstDaySlug, loadAllDocs } from "../lib/catalog";

const base = import.meta.env.BASE_URL;
const start = `${base}${firstDaySlug()}/`;
const docs = loadAllDocs();
const dayCount = docs.filter((d) => d.kind === "day").length;
const monthCount = docs.filter((d) => d.kind === "month").length;
---

<Base title="Full-Stack Mastery Textbook" description="An 18-month university-style textbook for the browser. Months 1–9 are in print. Read one page a day, type every lab, and build the eight projects from the specifications — never from pasted solutions.">
  <Header current="home" />
  <main class="home" id="content">
    <section class="hero-home">
      <p class="eyebrow">Eighteen months · One page a day</p>
      <h1>A modern textbook for becoming a full-stack engineer.</h1>
      <p class="lede">
        Read it like an article. Study it like a course. Months 1–9 are complete:
        machine to FastAPI. You type every lab. The eight numbered projects live in
        the specifications — this book never hands you those solutions.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={start}>Begin Month 1, Day 1</a>
        <a class="btn btn-ghost" href={`${base}projects/`}>Project specifications</a>
        <a class="btn btn-ghost" href={`${base}roadmap/`}>Full roadmap</a>
      </div>
    </section>

    <section class="stats" aria-label="Program size">
      <div class="stat"><b>18</b><span>months in the program</span></div>
      <div class="stat"><b>{monthCount}</b><span>months in print now</span></div>
      <div class="stat"><b>{dayCount}</b><span>daily textbook chapters</span></div>
      <div class="stat"><b>8</b><span>projects you build yourself</span></div>
    </section>

    <h2 class="section-title" id="how">How to read this book</h2>
    <div class="rules">
      <article class="rule">
        <h3>One URL, one study day</h3>
        <p>Order is mandatory. Do not skip a gate because the calendar moved.</p>
      </article>
      <article class="rule">
        <h3>The book is the lesson</h3>
        <p>Theory is in the chapter. End-of-page links are for later rechecking, not first learning.</p>
      </article>
      <article class="rule">
        <h3>Type the labs</h3>
        <p>Do not paste. If you cannot explain a line, it is not yours yet.</p>
      </article>
      <article class="rule">
        <h3>Projects are separate</h3>
        <p>Specifications are here. Complete project source is never in this textbook.</p>
      </article>
    </div>

    <h2 class="section-title" id="months">The eighteen months</h2>
    <div class="month-grid">
      {MONTHS.map((month) =>
        month.status === "published" ? (
          <a class="month-card" href={`${base}${month.slug}/`}>
            <span class="n">Month {String(month.number).padStart(2, "0")} · {month.phase}</span>
            <h3>{month.title}</h3>
            <p>{month.blurb}</p>
            <span class="badge">In print</span>
          </a>
        ) : (
          <div class="month-card disabled">
            <span class="n">Month {String(month.number).padStart(2, "0")} · {month.phase}</span>
            <h3>{month.title}</h3>
            <p>{month.blurb}</p>
            <span class="badge wait">Forthcoming</span>
          </div>
        )
      )}
    </div>
  </main>
  <footer class="site-footer">
    <span>Full-Stack Mastery Textbook · 2026</span>
    <span>Warm paper, signal blue, one chapter at a time.</span>
  </footer>
</Base>
