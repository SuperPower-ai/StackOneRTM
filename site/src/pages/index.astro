---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { MONTHS } from "../data/months";
import {
  firstDayOfMonth,
  firstDaySlug,
  isPublished,
  loadAllDocs,
  monthChapterCount,
} from "../lib/catalog";

const base = import.meta.env.BASE_URL;
const start = `${base}${firstDaySlug()}/`;
const docs = loadAllDocs();
const dayCount = docs.filter((d) => d.kind === "day").length;
const liveMonths = MONTHS.filter((month) => isPublished(month.number));
const laterMonths = MONTHS.filter((month) => !isPublished(month.number));
const newest = liveMonths.filter((month) => month.number >= 10);
const phases = [...new Set(liveMonths.map((month) => month.phase))];

const hrefFor = (monthNumber: number, slug: string) => {
  const first = firstDayOfMonth(monthNumber);
  return `${base}${first || slug}/`;
};
---

<Base
  title="Full-Stack Mastery Textbook"
  description="An 18-month university-style textbook in the browser. Months 1–14 are in print and open to read: from the machine on your desk through tests that catch a real break."
>
  <Header current="home" />
  <main class="home" id="content">
    <section class="hero-split">
      <div class="hero-home">
        <p class="eyebrow">A calm daily textbook · 18 months</p>
        <h1>Study like a course. Read it like a well-made book.</h1>
        <p class="lede">
          One URL is one study day. Months 1–14 are on the shelf and ready to open —
          SQL through tests landed with this edition. Projects stay in the specifications.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={start}>Start with Day 1</a>
          <a class="btn btn-secondary" data-home-continue href={start}>Continue reading</a>
          <a class="btn btn-ghost" href={`${base}month-10/`}>Open Month 10</a>
          <button class="btn btn-ghost" type="button" data-search-open>Search the book</button>
        </div>
      </div>
      <aside class="desk-card" aria-label="Your place in the book">
        <p class="desk-kicker">On the shelf now</p>
        <h2>{liveMonths.length} months you can open today.</h2>
        <p>
          {dayCount} daily chapters are in print. Months 15–18 are listed below as the
          path ahead — they are not broken buttons; they are not written yet.
        </p>
        <a class="btn btn-primary" href={`${base}month-01/`}>Browse Month 1</a>
        <ul class="desk-points">
          <li>Press <kbd>/</kbd> to search any day</li>
          <li>Continue always works — Day 1 until you read a page</li>
          <li>Type labs. Do not paste project apps</li>
        </ul>
      </aside>
    </section>

    <section class="stats" aria-label="Program size">
      <div class="stat"><b>18</b><span>months in the program</span></div>
      <div class="stat"><b>{liveMonths.length}</b><span>months you can open now</span></div>
      <div class="stat"><b>{dayCount}</b><span>daily chapters</span></div>
      <div class="stat"><b>8</b><span>projects you build yourself</span></div>
    </section>

    <section class="shelf" aria-labelledby="newest">
      <div class="shelf-head">
        <div>
          <p class="eyebrow">Just added</p>
          <h2 class="section-title" id="newest">Months 10–14 are ready</h2>
        </div>
        <p class="section-lead shelf-lead">
          PostgreSQL, SQLAlchemy, full-stack wiring, security, and tests. Each card is a real link.
        </p>
      </div>
      <div class="shelf-grid">
        {newest.map((month) => {
          const chapters = monthChapterCount(month.number);
          return (
            <a class="shelf-card" href={hrefFor(month.number, month.slug)}>
              <span class="shelf-num">Month {String(month.number).padStart(2, "0")}</span>
              <h3>{month.title}</h3>
              <p>{month.blurb}</p>
              <span class="shelf-cta">
                Read {chapters} days
                <span aria-hidden="true">→</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <h2 class="section-title" id="how">How this book treats you</h2>
    <div class="rules">
      <article class="rule">
        <span class="rule-n">01</span>
        <h3>You are a student, not a tourist</h3>
        <p>Order is mandatory. A gate that is false means stay. The calendar does not promote you.</p>
      </article>
      <article class="rule">
        <span class="rule-n">02</span>
        <h3>The chapter is the lesson</h3>
        <p>Theory lives here. End-of-page links are for later rechecking, not first learning.</p>
      </article>
      <article class="rule">
        <span class="rule-n">03</span>
        <h3>Your hands do the work</h3>
        <p>Type every lab. If you cannot explain a line, it is not yours yet.</p>
      </article>
      <article class="rule">
        <span class="rule-n">04</span>
        <h3>Projects are yours</h3>
        <p>Specifications are on this site. Complete project source is never in the textbook.</p>
      </article>
    </div>

    <h2 class="section-title" id="months">All months in print</h2>
    <p class="section-lead">
      Every card below is clickable. Open a month when the previous gate is true — the link still works so you can look ahead in the book.
    </p>
    {
      phases.map((phase) => (
        <section class="phase-block" aria-labelledby={`phase-${phase.replace(/\s+/g, "-").toLowerCase()}`}>
          <h3 class="phase-title" id={`phase-${phase.replace(/\s+/g, "-").toLowerCase()}`}>{phase}</h3>
          <div class="month-grid">
            {liveMonths.filter((month) => month.phase === phase).map((month) => {
              const chapters = monthChapterCount(month.number);
              return (
                <a class="month-card" href={`${base}${month.slug}/`}>
                  <span class="n">Month {String(month.number).padStart(2, "0")}</span>
                  <h3>{month.title}</h3>
                  <p>{month.blurb}</p>
                  <span class="card-foot">
                    <span class="meta">{chapters} days</span>
                    <span class="card-btn">Open</span>
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      ))
    }

    <section class="later" aria-labelledby="later">
      <h2 class="section-title" id="later">Still being written</h2>
      <p class="section-lead">
        These are the next four months in the program. They are not inactive copies of the cards above — there is no textbook file for them yet.
      </p>
      <ol class="later-list">
        {laterMonths.map((month) => (
          <li>
            <span class="later-num">{String(month.number).padStart(2, "0")}</span>
            <div>
              <strong>{month.title}</strong>
              <p>{month.blurb}</p>
            </div>
            <span class="later-tag">{month.phase}</span>
          </li>
        ))}
      </ol>
    </section>
  </main>
  <footer class="site-footer">
    <span>Full-Stack Mastery Textbook · 2026</span>
    <span>Fourteen months in print. Four still ahead.</span>
  </footer>
</Base>
