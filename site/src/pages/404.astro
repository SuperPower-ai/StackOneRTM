---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found" description="That chapter is not in this edition.">
  <Header />
  <main class="home" id="content">
    <section class="hero-home">
      <p class="eyebrow">404</p>
      <h1>This page is not in the textbook.</h1>
      <p class="lede">
        The URL may be mistyped, or that month is still forthcoming. Months 1–9 are in print.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={base}>Return home</a>
        <a class="btn btn-ghost" href={`${base}month-01/week-01/day-01/`}>Open Day 1</a>
      </div>
    </section>
  </main>
</Base>
