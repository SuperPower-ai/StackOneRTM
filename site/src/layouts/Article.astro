---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Toc from "../components/Toc.astro";
import PrevNext from "../components/PrevNext.astro";
import type { DocRecord } from "../lib/catalog";
import type { TocItem } from "../lib/markdown";
import { monthInfo } from "../data/months";

type Props = {
  doc: DocRecord;
  html: string;
  toc: TocItem[];
  prev?: DocRecord;
  next?: DocRecord;
  section?: "read" | "projects" | "roadmap";
};

const { doc, html, toc, prev, next, section = "read" } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (slug: string) => `${base}${slug.replace(/^\/+/, "")}${slug.endsWith("/") ? "" : "/"}`;
const info = doc.month ? monthInfo(doc.month) : undefined;
const crumbs: { href: string; label: string }[] = [{ href: base, label: "Textbook" }];
if (doc.kind === "roadmap") crumbs.push({ href: withBase("roadmap"), label: "Roadmap" });
if (doc.kind === "projects-index" || doc.kind === "project") {
  crumbs.push({ href: withBase("projects"), label: "Projects" });
}
if (doc.month) {
  crumbs.push({
    href: withBase(`month-${String(doc.month).padStart(2, "0")}`),
    label: `Month ${doc.month}`,
  });
}
if (doc.week) crumbs.push({ href: withBase(doc.slug), label: `Week ${doc.week}` });
if (doc.day) crumbs.push({ href: withBase(doc.slug), label: `Day ${doc.day}` });

const chips = [
  doc.meta["Phase"],
  doc.meta["Week rhythm today"],
  doc.meta["Study time"],
  info?.phase,
].filter((value, index, all): value is string => Boolean(value) && all.indexOf(value) === index);
---

<Base title={doc.title} description={doc.description} kicker={doc.kicker}>
  <Header current={section} />
  <div class="overlay" data-nav-overlay></div>
  <div class="shell">
    <Sidebar currentSlug={doc.slug} />
    <div class="article-wrap">
      <article class="article" id="content" data-pagefind-body>
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              <a href={c.href}>{c.label}</a>
            </>
          ))}
        </nav>
        <header class="hero">
          {doc.kicker && <p class="kicker">{doc.kicker}</p>}
          <h1 data-pagefind-meta="title">{doc.title}</h1>
          {doc.description && <p class="lede">{doc.description}</p>}
          {chips.length > 0 && (
            <div class="chips">
              {chips.map((chip) => <span class="chip">{chip}</span>)}
            </div>
          )}
        </header>
        <div class="content" set:html={html} />
        <PrevNext prev={prev} next={next} />
      </article>
    </div>
    <Toc items={toc} />
  </div>
  <footer class="site-footer">
    <span>Full-Stack Mastery Textbook · 2026</span>
    <span>Type the labs. Do not paste project solutions.</span>
  </footer>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: doc.title,
    description: doc.description,
    isPartOf: {
      "@type": "Book",
      name: "Full-Stack Mastery Textbook",
      datePublished: "2026",
    },
  })} />
</Base>
